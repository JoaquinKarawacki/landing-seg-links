# Clave compartida para acceder a /directivos (gerencia general y directores).
CLAVE_DIRECTIVOS=

# Secreto usado para firmar la cookie de sesión de /directivos (HMAC-SHA256).
# Generar uno random, por ejemplo: openssl rand -hex 32
CLAVE_DIRECTIVOS_SECRETO=

# Clave compartida para acceder a /dashboard-gerencial (etiqueta visible en la home).
CLAVE_DASHBOARD_GERENCIAL=

# Secreto usado para firmar la cookie de sesión de /dashboard-gerencial (HMAC-SHA256).
# Generar uno random, distinto al de arriba, por ejemplo: openssl rand -hex 32
CLAVE_DASHBOARD_GERENCIAL_SECRETO=
