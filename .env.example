# Clave compartida para acceder a /directivos (gerencia general y directores).
CLAVE_DIRECTIVOS=

# Secreto usado para firmar la cookie de sesión de /directivos (HMAC-SHA256).
# Generar uno random, por ejemplo: openssl rand -hex 32
CLAVE_DIRECTIVOS_SECRETO=

# Clave compartida para acceder a /dashboard-gerencial (etiqueta visible en la home).
CLAVE_DASHBOARD_GERENCIAL=

# Secreto usado para firmar la cookie de sesión de /dashboard-gerencial (HMAC-SHA256).
# Generar uno random, distinto al de arriba, por ejemplo: openssl rand -hex 32
CLAVE_DASHBOARD_GERENCIAL_SECRETO=

# Clave compartida para acceder a /dashboard-rodamientos (Dashboard de Rodamientos, gateado desde la grilla).
CLAVE_DASHBOARD_RODAMIENTOS=

# Secreto usado para firmar la cookie de sesión de /dashboard-rodamientos (HMAC-SHA256).
# Generar uno random, distinto a los de arriba, por ejemplo: openssl rand -hex 32
CLAVE_DASHBOARD_RODAMIENTOS_SECRETO=

# Clave compartida para acceder a /admin-documentos (panel para subir/eliminar documentos).
CLAVE_ADMIN_DOCUMENTOS=

# Secreto usado para firmar la cookie de sesión de /admin-documentos (HMAC-SHA256).
# Generar uno random, distinto a los de arriba, por ejemplo: openssl rand -hex 32
CLAVE_ADMIN_DOCUMENTOS_SECRETO=

# Carpeta donde se guardan los documentos subidos (archivos + índice de metadata).
# En Railway, apuntar al mount path del Volumen persistente, ej: /data/documentos
# Si se deja vacío, en local usa ./almacenamiento/documentos dentro del repo.
RUTA_ALMACENAMIENTO_DOCUMENTOS=
